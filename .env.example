# Copy to .env.local and fill in. Never commit .env.local.

# 21st.dev MCP server (component search//get). Referenced by .mcp.json.
21ST_API_KEY=

# --- Filled in during implementation (see docs/superpowers/specs/) ---
# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Envelope encryption KEK for user BYOK provider keys (32 bytes, base64)
BYOK_KEK=
BYOK_KEK_VERSION=1
