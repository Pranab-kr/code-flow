# Copy to .env.local and fill in. Never commit .env.local.

# 21st.dev MCP server (component search/get). Referenced by .mcp.json.
TWENTYFIRST_API_KEY=

# --- Supabase ---------------------------------------------------------------
# Dashboard → Project Settings → API Keys.
# We use the NEW key format (sb_publishable_… / sb_secret_…), not the legacy
# anon/service_role JWTs. Both work, but the new ones rotate independently.
NEXT_PUBLIC_SUPABASE_URL=
# Safe in a browser — RLS is what protects the data, not this key's secrecy.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# BYPASSES RLS. Server-only. Never expose it, never prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Inngest ----------------------------------------------------------------
# Not needed locally: `pnpm dlx inngest-cli@latest dev` runs without keys.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- BYOK envelope encryption ----------------------------------------------
# Wraps users' own provider API keys at rest. Generate with:
#   openssl rand -base64 32
# LOSING THIS makes every stored user key permanently unreadable. Back it up.
BYOK_KEK=
BYOK_KEK_VERSION=1
