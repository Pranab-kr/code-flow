{
  "name": "code-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm grammars && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:rls": "vitest run --project rls",
    "typecheck": "tsc --noEmit",
    "grammars": "mkdir -p public/grammars && cp node_modules/web-tree-sitter/web-tree-sitter.wasm public/grammars/ && cp node_modules/tree-sitter-python/tree-sitter-python.wasm node_modules/tree-sitter-cpp/tree-sitter-cpp.wasm node_modules/tree-sitter-java/tree-sitter-java.wasm node_modules/tree-sitter-javascript/tree-sitter-javascript.wasm public/grammars/"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.10",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@uiw/react-codemirror": "4.25.11",
    "@xyflow/react": "12.11.5",
    "elkjs": "0.12.0",
    "geist": "^1.7.2",
    "inngest": "4.18.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tree-sitter-javascript": "0.25.0",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "supabase": "2.116.0",
    "tailwindcss": "^4",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-python": "0.25.0",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.11"
  }
}
